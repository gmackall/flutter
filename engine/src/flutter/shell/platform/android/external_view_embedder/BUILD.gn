import("//flutter/common/config.gni")
import("//flutter/testing/testing.gni")

source_set("external_view_embedder") {
  sources = [
    "external_view_embedder.cc",
    "external_view_embedder.h",
    "external_view_embedder_2.cc",
    "external_view_embedder_2.h",
    "external_view_embedder_wrapper.cc",
    "external_view_embedder_wrapper.h",
    "platform_view_runtime_shader.cc",
    "platform_view_runtime_shader.h",
    "surface_pool.cc",
    "surface_pool.h",
  ]

  public_configs = [ "//flutter:config" ]

  deps = [
    "//flutter/common",
    "//flutter/flow",
    "//flutter/fml",
    "//flutter/impeller/renderer/backend/vulkan",
    "//flutter/impeller/runtime_stage",
    "//flutter/shell/platform/android/context",
    "//flutter/shell/platform/android/jni",
    "//flutter/shell/platform/android/surface",
    "//flutter/skia",
  ]

  public_deps = [ "//third_party/abseil-cpp/absl/container:flat_hash_set" ]
}

test_fixtures("external_view_embedder_fixtures") {
  # Runtime stages compiled by impellerc with --sksl and all Impeller backends.
  impeller_fixtures_dir = "$root_gen_dir/flutter/impeller/fixtures"
  fixtures = [
    "$impeller_fixtures_dir/ink_sparkle.frag.iplr",
    "$impeller_fixtures_dir/runtime_stage_filter_example.frag.iplr",
    "$impeller_fixtures_dir/uniforms_and_sampler_2.frag.iplr",
  ]
  deps = [ "//flutter/impeller/fixtures:runtime_stages" ]
}

executable("android_external_view_embedder_unittests") {
  testonly = true

  sources = [
    "external_view_embedder_unittests.cc",
    "platform_view_runtime_shader_unittests.cc",
    "surface_pool_unittests.cc",
  ]

  deps = [
    ":external_view_embedder",
    ":external_view_embedder_fixtures",
    "//flutter/flow",
    "//flutter/impeller/runtime_stage",
    "//flutter/shell/gpu:gpu_surface_gl",
    "//flutter/shell/platform/android/jni:jni_mock",
    "//flutter/shell/platform/android/surface",
    "//flutter/shell/platform/android/surface:surface_mock",
    "//flutter/testing",
    "//flutter/testing:dart",
    "//flutter/testing:skia",
  ]
}
